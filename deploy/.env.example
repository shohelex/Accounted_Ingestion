# Copy to .env and fill in. Generate secrets with: openssl rand -hex 32
NEO4J_PASSWORD=
MINIO_USER=minioadmin
MINIO_PASSWORD=

# Ed25519 seed of the deployment key (64 hex characters). Receipts, anchors and statements are
# signed with it; auditors and the judge need only its public key.
MERKLE_SIGNING_SEED=

# Ed25519 seed for submitting statements to the Sigsum log (64 hex characters).
SIGSUM_SUBMIT_SEED=

# Admin API key for the ingest API (at least 32 characters) and its tenant.
BOOTSTRAP_API_KEY=
BOOTSTRAP_TENANT_ID=default

# Topic partitions and writer processes.
PARTITIONS=8
WRITERS=4
API_WORKERS=4

# Contract parameters (seconds): period P, deadline Theta, publication delay.
ACCT_PERIOD_S=360
ACCT_THETA_S=300
ACCT_DELTA_PUB_S=80

# Records per append (B) and anchor every k records.
MERKLE_APPEND_BATCH_B=32
MERKLE_ANCHOR_BATCH_K=100

# Baselines: ACCT_CAA=false with ACCT_ABLATION_OK=true commits after the database write;
# ACCT_ACK_AFTER_ANCHOR=true acknowledges only after the anchor; ACCT_MODE=false turns accounting off.
ACCT_MODE=true
ACCT_CAA=true
ACCT_ABLATION_OK=false
ACCT_ACK_AFTER_ANCHOR=false
